    "popularidad_artista = BD_limpia.groupby('artists')['popularity'].agg(\n",
    "    cantidad='count',\n",
    "    promedio='mean',\n",
    "    desviacion='std',\n",
    "    minimo='min',\n",
    "    maximo='max'\n",
    ")\n",
    "\n",
    "popularidad_artista = popularidad_artista[\n",
    "    popularidad_artista['cantidad'] >= 10\n",
    "].sort_values('desviacion', ascending=False)\n",
    "\n",
    "popularidad_artista.head(10)"
   ]

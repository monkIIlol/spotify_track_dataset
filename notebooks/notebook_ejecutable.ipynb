   "source": [
    "## 4. Ingeniería de Datos"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "WzoPjOAyp6Fu",
   "metadata": {
    "id": "WzoPjOAyp6Fu"
   },
   "source": [
    "Agregaremos características simples para mejorar interpretabilidad y análisis:\n",
    "\n",
    "- duration_m → duration_min: convertido a minutos\n",
    "- mode → mode_name: map mode (0/1) → Minor/Major\n",
    "- key → key_map: map key (0,1,2,...10,11) → C, C#/Db, D, ..., A#/Bb, B"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9CfnJbC7qbyu",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "9CfnJbC7qbyu",
    "outputId": "9b60a7d8-0883-468a-a6e7-553e38ff482a"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   duration_ms  duration_min  mode mode_name  key key_name\n",
      "0       230666      3.844433     0     Minor    1    C#/Db\n",
      "1       149610      2.493500     1     Major    1    C#/Db\n",
      "2       210826      3.513767     1     Major    0        C\n"
     ]
    }
   ],
   "source": [
    "# duration_m → duration_min\n",
    "BD[\"duration_min\"] = BD[\"duration_ms\"] / 60000\n",
    "\n",
    "# mode → mode_name\n",
    "BD[\"mode_name\"] = BD[\"mode\"].map({1: \"Major\", 0: \"Minor\"})\n",
    "\n",
    "# key → key_map\n",
    "key_map = {\n",
    "    0: \"C\", 1: \"C#/Db\", 2: \"D\", 3: \"D#/Eb\",\n",
    "    4: \"E\", 5: \"F\", 6: \"F#/Gb\", 7: \"G\",\n",
    "    8: \"G#/Ab\", 9: \"A\", 10: \"A#/Bb\", 11: \"B\",\n",
    "    -1: \"Unknown\"\n",
    "}\n",
    "BD[\"key_name\"] = BD[\"key\"].map(key_map)\n",
    "\n",
    "# Ver resultados\n",
    "print(BD[\n",
    "    [\n",
    "        \"duration_ms\", \"duration_min\",\n",
    "        \"mode\", \"mode_name\",\n",
    "        \"key\", \"key_name\"\n",
    "    ]\n",
    "].head(3))"
   ]
  },
